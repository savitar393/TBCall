# TBCall Database Configuration
# Copy this file to .env and fill in your credentials

TBCALL_DB_URL=jdbc:postgresql://localhost:5432/tbcall
TBCALL_DB_USER=postgres
TBCALL_DB_PASSWORD=your_password_here

# Optional settings
TBCALL_PRODUCTION=false
TBCALL_EXPOSE_VERIFICATION_TOKENS=true
TBCALL_COOKIE_SECURE=false
